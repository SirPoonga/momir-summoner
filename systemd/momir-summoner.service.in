[Unit]
Description=Momir Summoner Web App
Wants=network-online.target
After=network-online.target bluetooth.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@APP_DIR@
Environment=HOME=@APP_HOME@
Environment=PYTHONUNBUFFERED=1
Environment=MOMIR_CONFIG_PATH=@APP_DIR@/config.local.json
ExecStart=@APP_DIR@/venv/bin/python @APP_DIR@/webapp/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
